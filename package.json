{
  "name": "property-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @property/web",
    "build": "npm run build --workspace @property/web",
    "start": "npm run start --workspace @property/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @property/web",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate-cli.ts",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "5.0.1"
  }
}
