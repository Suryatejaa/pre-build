# Copy to .env at the repository root. Never commit the resulting file.
DATABASE_URL=postgresql://property:property_local@localhost:54329/property
TEST_DATABASE_URL=postgresql://property:property_local@localhost:54329/property_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
STORAGE_LOCAL_ROOT=.data/objects
# Production must use HTTPS and a trusted proxy which overwrites this header.
AUTH_IP_HEADER=x-real-ip
# Server-only AI configuration. A key alone enables Sarvam after server restart.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Missing keys skip their slots. Fallbacks are optional Chat Completions JSON-schema APIs.
AI_PROVIDER_ORDER=sarvam,fallback-a,fallback-b
AI_PROVIDER_TIMEOUT_MS=60000
AI_FALLBACK_A_URL=
AI_FALLBACK_A_API_KEY=
AI_FALLBACK_A_MODEL=
AI_FALLBACK_B_URL=
AI_FALLBACK_B_API_KEY=
AI_FALLBACK_B_MODEL=
# Legacy fallback A variables (used only when AI_FALLBACK_A_API_KEY is absent).
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
